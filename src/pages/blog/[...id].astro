---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/site';
import { getPosts, articleUrl, withBase, dateText, readingTime, tagUrl } from '../../lib/blog';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { id: post.id }, props: { post, previous: posts[index + 1], next: posts[index - 1] } }));
}
interface Props { post: CollectionEntry<'blog'>; previous?: CollectionEntry<'blog'>; next?: CollectionEntry<'blog'>; }
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
---
<Base title={post.data.title} description={post.data.description}>
  <div class="article-back"><a class="text-link" href={withBase('/blog/')}>← 返回文章列表</a></div>
  <header class="article-header"><p class="eyebrow">{post.data.category}{post.data.demo && <span class="demo-label">示例文章</span>}</p><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><span>{profile.name}</span><span>·</span><time datetime={post.data.pubDate.toISOString()}>{dateText(post.data.pubDate)}</time><span>·</span><span>约 {readingTime(post)} 分钟</span>{post.data.updatedDate && <span>更新于 {dateText(post.data.updatedDate)}</span>}</div></header>
  <div class="article-layout">
    <article class="article-content">
      {post.data.demo && <aside class="notice">这是一篇用于展示排版的示例内容，并非作者的真实学习经历或实验结果。</aside>}
      <div class="prose"><Content /></div>
      <div class="article-tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div>
      <div class="article-end"><span>写到这里，留一点思考给下一次。</span><a href={`mailto:${profile.email}`}>交流想法 ↗</a></div>
      <nav class="article-pagination" aria-label="相邻文章">{previous ? <a href={articleUrl(previous.id)}><small>← 更早的记录</small><span>{previous.data.title}</span></a> : <span/>}{next ? <a href={articleUrl(next.id)}><small>更新的记录 →</small><span>{next.data.title}</span></a> : <span/>}</nav>
    </article>
    {toc.length > 0 && <aside class="article-toc"><p class="eyebrow">ON THIS PAGE</p><h2>这篇文章里</h2><nav aria-label="文章目录">{toc.map(heading => <a href={`#${heading.slug}`} class:list={{ indent: heading.depth === 3 }}>{heading.text}</a>)}</nav><a class="back-top" href="#main">回到顶部 ↑</a></aside>}
  </div>
</Base>
