---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, withBase } from '../../lib/blog';
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap(post => post.data.tags))];
  return tags.map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`标签：${tag}`}><section class="page-heading"><a class="text-link" href={withBase('/archive/')}>← 所有标签</a><p class="eyebrow">EXPLORE A TOPIC</p><h1>#{tag}</h1><p>这个主题下，共 {posts.length} 篇记录。</p></section><div class="post-grid blog-grid">{posts.map(post => <PostCard post={post} />)}</div></Base>
